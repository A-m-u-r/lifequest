{
  "name": "lifequest",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\" --ignore-path .prettierignore",
    "check-types": "turbo run check-types",
    "sb": "pnpm --filter @repo/ui sb",
    "build-sb": "pnpm --filter @repo/ui build-sb",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\" --ignore-path .prettierignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2",
    "husky": "9.1.7"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "version": "0.0.1"
}
