{
  "name": "@repo/ui",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./atoms/*": "./src/atoms/*/index.ts",
    "./molecules/*": "./src/molecules/*/index.ts",
    "./organisms/*": "./src/organisms/*/index.ts",
    "./layouts/*": "./src/layouts/*/index.ts",
    "./hooks/*": "./src/hooks/*/index.ts",
    "./hocs/*": "./src/hocs/*/index.ts",
    "./libs/*": "./src/libs/*/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -b --noEmit",
    "sb": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-sb": "storybook build --disable-telemetry",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json,md,mdx}\"",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@types/node": "^24.13.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "type": "module",
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "lucide-react": "1.70.0"
  }
}
